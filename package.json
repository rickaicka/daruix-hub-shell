{
  "name": "daruix-hub-shell",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:mfe": "npm --prefix ../daruix-mfe-remessas start",
    "dev": "concurrently -k -n SHELL,REMESSAS -c cyan,magenta \"npm start\" \"npm run start:mfe\"",
    "build": "npm run build:mfe && npm run sync:mfe && npm run build:shell",
    "build:shell": "ng build --configuration=production",
    "build:dev": "ng build --configuration=development",
    "build:mfe": "npm --prefix ../daruix-mfe-remessas run build",
    "sync:mfe": "node -e \"const fs=require('node:fs');const source='../daruix-mfe-remessas/dist/daruix-mfe-remessas';const target='public/remotes/remessas';if(!fs.existsSync(source))throw new Error('Build do MFE nao encontrado: '+source);fs.rmSync(target,{recursive:true,force:true});fs.mkdirSync(target,{recursive:true});fs.cpSync(source,target,{recursive:true});\"",
    "build:mobile": "npm run build",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "android:sync": "npm run build:mobile && npx cap sync android",
    "android:run": "npm run android:sync && npx cap run android --no-sync",
    "android:open": "npx cap open android",
    "android:targets": "npx cap run android --list",
    "android:clean": "cd android && gradlew.bat clean",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:aab": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "android:doctor": "npx cap doctor",
    "resources": "npx capacitor-assets generate && npx cap sync android"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular-architects/native-federation": "^21.2.5",
    "@angular/animations": "^21.2.17",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@daruix/hub-auth": "^0.0.10",
    "@daruix/hub-ui": "^0.2.5",
    "@ionic/angular": "^8.8.6",
    "@ionic/storage-angular": "^4.0.0",
    "@lucide/angular": "^1.14.0",
    "@ngrx/signals": "^21.1.1",
    "@softarc/native-federation-node": "^3.3.4",
    "es-module-shims": "^1.5.12",
    "ionicons": "^8.0.13",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.15",
    "@angular/build": "^21.2.15",
    "@angular/cli": "^21.2.15",
    "@angular/compiler-cli": "^21.2.17",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@ionic/angular-toolkit": "^12.3.0",
    "@ionic/cli": "^7.2.1",
    "@types/jasmine": "~5.1.0",
    "concurrently": "^9.2.1",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.3"
  }
}
